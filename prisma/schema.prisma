  milestone Milestone? @relation("MilestoneTrigger", fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("n8n_webhooks")
}

model ProjectAIModel {
  projectId String @map("project_id")
  modelId   String @map("model_id")
  role      String @default("output")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  model   AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([projectId, modelId])
  @@map("project_ai_models")
}

enum ArtifactCategory {
  BRD
  PROJECT_PLAN
  TEST_CASES
  FRD
  DESIGN_DOCUMENT
  BUSINESS_CASE
  MODEL_ARTIFACT
  TRAINING_DATA
  EVALUATION_REPORT
  COMPLIANCE_EVIDENCE
  OTHER
}

model ProjectArtifact {
  id          String           @id @default(uuid())
  projectId   String           @map("project_id")
