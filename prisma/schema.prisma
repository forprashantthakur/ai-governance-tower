}

// ─── Approval Workflow ────────────────────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
  WITHDRAWN
}

enum ApprovalStepType {
  RISK_OFFICER
  LEGAL
  ETHICS
  DATA_PROTECTION
  EXECUTIVE
  CUSTOM
}

enum HarmCategory {
  DISCRIMINATION
  PRIVACY_VIOLATION
  FINANCIAL_HARM
  PHYSICAL_HARM
  REPUTATIONAL_HARM
  AUTONOMY_VIOLATION
  SOCIETAL_HARM
  SECURITY_HARM
  OTHER
}

model ApprovalWorkflow {
  id             String         @id @default(uuid())
  organizationId String?        @map("organization_id")
  modelId        String?        @map("model_id")
  title          String
  description    String?
  status         ApprovalStatus @default(PENDING)
  requestedBy    String         @map("requested_by")
  dueDate        DateTime?      @map("due_date")
  completedAt    DateTime?      @map("completed_at")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  model        AIModel?       @relation(fields: [modelId], references: [id], onDelete: SetNull)
  requester    User           @relation("WorkflowRequester", fields: [requestedBy], references: [id])
  steps        ApprovalStep[]

  @@index([organizationId])
  @@map("approval_workflows")
}

model ApprovalStep {
  id         String           @id @default(uuid())
  workflowId String           @map("workflow_id")
  stepType   ApprovalStepType @map("step_type")
  stepOrder  Int              @map("step_order")
  label      String
  assigneeId String?          @map("assignee_id")
  status     ApprovalStatus   @default(PENDING)
  comments   String?
  decidedAt  DateTime?        @map("decided_at")
  dueDate    DateTime?        @map("due_date")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  assignee User?            @relation("StepAssignee", fields: [assigneeId], references: [id])

  @@index([workflowId])
  @@map("approval_steps")
}

model MisuseScenario {
  id             String       @id @default(uuid())
  modelId        String       @map("model_id")
  title          String
  description    String
  likelihood     Int          // 1-5
  severity       Int          // 1-5
  harmCategory   HarmCategory @map("harm_category")
  affectedGroups String[]     @default([]) @map("affected_groups")
  mitigations    String?
  isAddressed    Boolean      @default(false) @map("is_addressed")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  model AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@map("misuse_scenarios")
}

// ─── Alert Rules ─────────────────────────────────────────────────────────────

model AlertRule {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  name           String
  metric         String   // e.g. "toxicity_score", "latency_ms", "flag_rate"
  threshold      Float
  condition      String   @default("gt")  // gt | lt | eq
  severity       AlertSeverity @default(WARNING)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("alert_rules")
}

// ─── AI Maturity Assessment ───────────────────────────────────────────────────

enum MaturityStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model MaturityAssessment {
  id                  String         @id @default(uuid())
  organizationId      String         @map("organization_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  // Inputs
  organizationProfile String         @map("organization_profile")
  industry            String
  functions           String[]       @default([])
  maturityScore       Int            @map("maturity_score")   // 1–5 scale
  dataSources         String[]       @default([]) @map("data_sources")
  existingSystems     String[]       @default([]) @map("existing_systems")
  businessGoals       String[]       @default([]) @map("business_goals")

  // Generated output
  useCases            Json?          @map("use_cases")       // Array of use case objects
  status              MaturityStatus @default(PENDING)
  errorMessage        String?        @map("error_message")

